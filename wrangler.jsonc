{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flashlearn",
  "pages_build_output_dir": "./out",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": [
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "nextjs"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
